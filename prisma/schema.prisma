// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  password       String
  full_name      String
  sessions       Session[]
  transactions   Transaction[]
  money_accounts Account[]
  currencies     Currency[]
  tags           Tag[]
  contacts       Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Transaction {
  id     String            @id @default(cuid())
  type   TransactionType
  status TransactionStatus @default(COMPLETED)
  tags   Tag[]
  notes  String?

  amount     BigInt
  currency   Currency    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  currencyId String
  conversion Conversion?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  sourceAccount   Account? @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  sourceAccountId String?

  destinationAccount   Account? @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  destinationAccountId String?

  externalParty String? // For transaction involving external account (for money sent to or received from external source)
  contactId     String? // For transaction with people saved as "contact"
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  completedAt DateTime?
  cancelledAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Conversion {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  fromCurrencyId String
  fromCurrency   Currency @relation(name: "fromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)

  toCurrencyId String
  toCurrency   Currency @relation(name: "toCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  rate       Decimal
  fromAmount BigInt // the same as "amount" in transaction table
  toAmount   BigInt
}

model Account {
  id          String      @id @default(cuid())
  name        String
  type        AccountType
  description String?
  balance     BigInt      @default(0)
  isArchived  Boolean     @default(false)
  archivedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  currencyId String

  incomingTransactions Transaction[] @relation("SourceAccount")
  outgoingTransactions Transaction[] @relation("DestinationAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name], where: raw("'isArchived' = 'false'")) // Prevent duplicate active accounts per user
}

model Currency {
  id        String       @id @default(cuid())
  code      String
  symbol    String?
  name      String?
  type      CurrencyType
  precision Int          @default(2) // ETB=2, USD=2, BTC=8, ETH=18 etc

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? // null for global currencies

  convertedFrom Conversion[]  @relation("fromCurrency")
  convertedTo   Conversion[]  @relation("toCurrency")
  transactions  Transaction[]
  accounts      Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code]) // Prevent duplicate currency codes per user
}

model Tag {
  id           String        @id @default(cuid())
  name         String
  color        String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name]) // Prevent duplicate names per user
}

model Contact {
  id    String  @id @default(uuid())
  name  String
  email String?
  phone String?
  notes String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//  ============== ENUMS ==============

enum TransactionType {
  RECEIVE
  SEND
  MOVE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CurrencyType {
  FIAT
  CRYPTO
}

enum AccountType {
  CASH
  BANK
  CRYPTO
  CREDIT_CARD
  SAVINGS
  INVESTMENT
  OTHER
}
